# Railway server
PORT=8787
CORS_ORIGIN=http://localhost:5173,https://your-railway-domain.up.railway.app

# Backend presets: keys stay on Railway and are never returned by /api/ai/presets
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Optional JSON array to replace the built-in presets.
# Each keyEnv points to another Railway environment variable. Do not put raw keys here.
# AI_PRESETS_JSON=[{"id":"qwen","label":"Qwen","provider":"OpenAI-compatible","baseUrl":"https://dashscope.aliyuncs.com/compatible-mode/v1","model":"qwen-plus","keyEnv":"QWEN_API_KEY"}]

# Safety controls for custom endpoints.
# Add exact hostnames only, for example: api.openai.com,api.deepseek.com
ALLOWED_AI_HOSTS=api.openai.com,api.deepseek.com
ALLOW_PRIVATE_AI_URLS=false
AI_RATE_LIMIT=12
