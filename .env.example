# Local development only; Railway supplies PORT automatically.
PORT=8787
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,https://your-railway-domain.up.railway.app

# The only author preset: 作者预设6.1-sol. The real Key stays on the backend.
CF_API_KEY=
CF_API_BASE_URL=https://cf.api.fan/v1
CF_API_MODEL=gpt-6.1-sol
# auto infers protocol from explicit endpoint; a base /v1 uses Chat Completions.
CF_API_PROTOCOL=auto
# gpt-6.1-sol reasoning models: medium is the default; use none only if the relay rejects reasoning.
CF_API_REASONING_EFFORT=medium

# Author-backend outbound allowlist only. Custom URLs are called directly by the browser.
ALLOWED_AI_HOSTS=cf.api.fan
ALLOW_PRIVATE_AI_URLS=false
AI_RATE_LIMIT=12

# Legacy OPENAI_*, DEEPSEEK_* and AI_PRESETS_JSON are no longer used.
